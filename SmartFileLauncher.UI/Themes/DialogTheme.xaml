<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="DialogSurface" Color="#F6F8FC"/>
    <SolidColorBrush x:Key="DialogInk" Color="#111827"/>
    <SolidColorBrush x:Key="DialogInk2" Color="#4A5462"/>
    <SolidColorBrush x:Key="DialogLine" Color="#D6DEEA"/>
    <SolidColorBrush x:Key="DialogAccent" Color="#3F7EE8"/>
    <SolidColorBrush x:Key="DialogDanger" Color="#DC4B3C"/>

    <Geometry x:Key="DialogInfoGeometry">M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 M12 11 V16 M12 8 V8.1</Geometry>
    <Geometry x:Key="DialogQuestionGeometry">M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 M9.6 9.6 A2.4 2.4 0 1 1 12 12.4 V14.2 M12 17.2 V17.3</Geometry>
    <Geometry x:Key="DialogWarningGeometry">M12 3.5 L21.5 20 H2.5 Z M12 9.5 V14 M12 16.8 V16.9</Geometry>
    <Geometry x:Key="DialogDangerGeometry">M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 M12 8 V13 M12 16 V16.1</Geometry>
    <Geometry x:Key="DialogPencilGeometry">M4 20 H8 L18.5 9.5 A2.1 2.1 0 0 0 14.5 5.5 L4 16 Z M13 7 L17 11</Geometry>
    <Geometry x:Key="DialogCheckGeometry">M3 8.5 L6.5 12 L13 4.5</Geometry>

    <Style x:Key="DialogTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource DialogInk}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="DialogMessage" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Foreground" Value="{StaticResource DialogInk2}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="20"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
    <Style x:Key="DialogTile" TargetType="Border">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="0,0,16,0"/>
        <Setter Property="Background" Value="#EEF4FF"/>
    </Style>

    <Style x:Key="DialogSecondaryButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="MinWidth" Value="92"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#2F4A73"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" CornerRadius="10" Background="#FFFFFF" BorderBrush="{StaticResource DialogLine}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#F3F7FE"/>
                            <Setter TargetName="Surface" Property="BorderBrush" Value="#B9CCEC"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="#E3ECFB"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource DialogAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="DialogPrimaryButton" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButton}">
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="Background" Value="{StaticResource DialogAccent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" CornerRadius="10" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.8"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="#99FFFFFF"/>
                            <Setter TargetName="Surface" Property="BorderThickness" Value="0,0,0,2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="DialogDangerButton" TargetType="Button" BasedOn="{StaticResource DialogPrimaryButton}">
        <Setter Property="Background" Value="{StaticResource DialogDanger}"/>
    </Style>

    <Style x:Key="DialogTextBox" TargetType="TextBox">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource DialogInk}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="{StaticResource DialogLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SelectionBrush" Value="#803F7EE8"/>
        <Setter Property="CaretBrush" Value="{StaticResource DialogInk}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Surface" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="#B9CCEC"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource DialogAccent}"/>
                            <Setter TargetName="Surface" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DialogCheckBox" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource DialogInk2}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" Background="#FFFFFF" BorderBrush="{StaticResource DialogLine}" BorderThickness="1" VerticalAlignment="Center">
                            <Path x:Name="Tick" Data="{StaticResource DialogCheckGeometry}" Stroke="#FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="10" Height="8" Stretch="Uniform" Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource DialogAccent}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource DialogAccent}"/>
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="#B9CCEC"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource DialogAccent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
