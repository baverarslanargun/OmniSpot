<Window x:Class="SmartFileLauncher.UI.Views.ThumbnailPinConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Küçük resimleri hızlı yükle" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#F6F8FC" FontFamily="Segoe UI" TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        KeyDown="Window_KeyDown" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/OmniSpot;component/Themes/DialogTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Padding="24,22,24,22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource DialogTile}" Background="#FFF3DD">
                    <Path Data="{StaticResource DialogWarningGeometry}" Stroke="#D98A0C" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="22" Height="22" Stretch="Uniform"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Bu özellik RAM kullanımını artırabilir" Style="{StaticResource DialogTitle}"/>
                    <TextBlock Text="Bu klasörde ve alt klasörlerinde gezinirken yüklenen küçük resimler, OmniSpot boşta kaldığında da RAM'de tutulur. Güvenli bellek sınırı dolarsa en eski kullanılan görseller çıkarılabilir."
                               Style="{StaticResource DialogMessage}"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="1" Margin="60,14,0,0" Background="#FFFFFF" BorderBrush="{StaticResource DialogLine}" BorderThickness="1" CornerRadius="10" Padding="12,8">
                <TextBlock x:Name="FolderText" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource DialogInk}" FontFamily="Consolas, Segoe UI"/>
            </Border>
            <CheckBox Grid.Row="2" x:Name="DoNotShowAgain" Content="Bir daha gösterme" Style="{StaticResource DialogCheckBox}" Margin="60,14,0,0"/>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Vazgeç" Style="{StaticResource DialogSecondaryButton}" Margin="0,0,10,0" IsCancel="True"/>
                <Button Content="Hızlı yüklemeyi aç" Style="{StaticResource DialogPrimaryButton}" IsDefault="True" Click="Confirm_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
