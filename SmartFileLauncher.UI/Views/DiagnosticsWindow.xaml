<Window x:Class="SmartFileLauncher.UI.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:SmartFileLauncher.UI.Services"
        xmlns:views="clr-namespace:SmartFileLauncher.UI.Views"
        Title="OmniSpot · Tanılama"
        Height="720"
        Width="1120"
        MinHeight="360"
        MinWidth="720"
        Background="White"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#1E293B"/>
        <SolidColorBrush x:Key="Ink2" Color="#64748B"/>
        <SolidColorBrush x:Key="Ink3" Color="#94A3B8"/>
        <SolidColorBrush x:Key="Line" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="LineStrong" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="Ground" Color="#F6F8FC"/>
        <SolidColorBrush x:Key="Hover" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="Accent" Color="#007AFF"/>
        <SolidColorBrush x:Key="AccentHover" Color="#0066DD"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#EAF2FF"/>
        <SolidColorBrush x:Key="Warning" Color="#B45309"/>
        <SolidColorBrush x:Key="Danger" Color="#B42318"/>
        <SolidColorBrush x:Key="DangerSoft" Color="#FEF3F2"/>
        <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>

        <Geometry x:Key="CopyGlyph">M5 5 H13.5 V13.5 H5 Z M3 10.5 V2.5 H10.5</Geometry>
        <Geometry x:Key="DoneGlyph">M3 8.5 L6.5 12 L13 4.5</Geometry>
        <Geometry x:Key="FolderGlyph">M1.5 3 H6 L7.5 4.5 H14.5 V13 H1.5 Z</Geometry>
        <Geometry x:Key="WarningGlyph">M12 3.5 L21.5 20 H2.5 Z M12 9.5 V14 M12 16.8 V16.9</Geometry>
        <Geometry x:Key="DangerGlyph">M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 M12 8 V13 M12 16 V16.1</Geometry>

        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource Hover}"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource LineStrong}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource Line}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Ink3}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Link" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource AccentSoft}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{StaticResource Ink3}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Track"
                                    Width="34"
                                    Height="20"
                                    CornerRadius="10"
                                    Background="{StaticResource LineStrong}"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Border x:Name="Thumb"
                                        Width="14"
                                        Height="14"
                                        CornerRadius="7"
                                        Background="White"
                                        HorizontalAlignment="Left"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Thumb" Property="Margin" Value="2,0,0,0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="16,0,0,0"/>
                            </Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                                    <Condition Binding="{Binding Enabled, Source={x:Static services:UiAnimationSettings.Current}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Margin" To="16,0,0,0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                            </MultiDataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="False"/>
                                    <Condition Binding="{Binding Enabled, Source={x:Static services:UiAnimationSettings.Current}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <MultiDataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ThicknessAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Margin" To="2,0,0,0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </MultiDataTrigger.EnterActions>
                            </MultiDataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.45"/>
                                <Setter Property="Foreground" Value="{StaticResource Ink3}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Check" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box"
                                    Width="16"
                                    Height="16"
                                    CornerRadius="4"
                                    Background="White"
                                    BorderBrush="{StaticResource LineStrong}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Tick"
                                      Data="{StaticResource DoneGlyph}"
                                      Stroke="White"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Width="9"
                                      Height="7"
                                      Stretch="Uniform"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="False"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Ink3}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.45"/>
                                <Setter Property="Foreground" Value="{StaticResource Ink3}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbSurface" Background="#B9C2CF" CornerRadius="3" Margin="2" Opacity="0.75"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Background" Value="#8E99A8"/>
                                <Setter TargetName="ThumbSurface" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Background" Value="#6B7684"/>
                                <Setter TargetName="ThumbSurface" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollPage" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="0,4,0,4">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,5">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="LogLineTemplate" DataType="{x:Type views:DiagnosticsLogLine}">
            <Border x:Name="Row" Padding="20,3" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Time}"
                               FontFamily="{StaticResource Mono}"
                               FontSize="12"
                               LineHeight="18"
                               Foreground="{StaticResource Ink2}"/>
                    <TextBlock x:Name="Message"
                               Grid.Column="1"
                               Text="{Binding Message}"
                               FontFamily="{StaticResource Mono}"
                               FontSize="12"
                               LineHeight="18"
                               Foreground="{StaticResource Ink}"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static views:DiagnosticsLogLevel.Warning}">
                    <Setter TargetName="Message" Property="Foreground" Value="{StaticResource Warning}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static views:DiagnosticsLogLevel.Error}">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource DangerSoft}"/>
                    <Setter TargetName="Message" Property="Foreground" Value="{StaticResource Danger}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,1"
                Padding="20,12,20,14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Tanılama"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Ink}"/>
                        <TextBlock x:Name="UpdatedText"
                                   FontSize="12"
                                   Foreground="{StaticResource Ink2}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="CopyButton" Style="{StaticResource Action}">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Path x:Name="CopyGlyphPath"
                                          Data="{StaticResource CopyGlyph}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.3"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Stretch="Uniform"/>
                                    <Path x:Name="CopyDonePath"
                                          Data="{StaticResource DoneGlyph}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Width="12"
                                          Height="10"
                                          Stretch="Uniform"
                                          Visibility="Collapsed"/>
                                </Grid>
                                <TextBlock x:Name="CopyLabel" Text="Kopyala" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ClearButton"
                                Content="Temizle"
                                Style="{StaticResource Action}"
                                Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="FileLoggingCheck"
                                  Content="Günlüğü yaz"
                                  Style="{StaticResource Switch}"/>
                        <TextBlock x:Name="FileLogCountText"
                                   FontSize="12"
                                   Foreground="{StaticResource Ink2}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="20,0,0,0">
                        <CheckBox x:Name="MetricLoggingCheck"
                                  Content="Sayaçları yaz"
                                  Style="{StaticResource Switch}"/>
                        <TextBlock x:Name="MetricLogCountText"
                                   FontSize="12"
                                   Foreground="{StaticResource Ink2}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                    <Rectangle Grid.Column="2"
                               Width="1"
                               Height="20"
                               Fill="{StaticResource Line}"
                               Margin="20,0"
                               VerticalAlignment="Center"/>
                    <Grid Grid.Column="3" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Path x:Name="FolderGlyphPath"
                                  Data="{StaticResource FolderGlyph}"
                                  Stroke="{StaticResource Ink2}"
                                  StrokeThickness="1.2"
                                  StrokeLineJoin="Round"
                                  Stretch="Uniform"/>
                            <Path x:Name="ErrorGlyphPath"
                                  Data="{StaticResource DangerGlyph}"
                                  Stroke="{StaticResource Danger}"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Stretch="Uniform"
                                  Visibility="Collapsed"/>
                        </Grid>
                        <TextBlock x:Name="LogStatusText"
                                   Grid.Column="1"
                                   FontSize="12"
                                   Foreground="{StaticResource Ink2}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <Button x:Name="ChooseDirectoryButton"
                            Grid.Column="4"
                            Content="Dizin seç…"
                            Style="{StaticResource Link}"
                            Margin="12,0,0,0"/>
                    <CheckBox x:Name="RememberDirectoryCheck"
                              Grid.Column="5"
                              Content="Dizini hatırla"
                              Style="{StaticResource Check}"
                              Margin="16,0,0,0"/>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <ItemsControl x:Name="LogList"
                          Grid.Column="0"
                          Focusable="False"
                          ItemTemplate="{StaticResource LogLineTemplate}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer x:Name="LogScroll"
                                      Focusable="False"
                                      CanContentScroll="True"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="0,8">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <TextBlock x:Name="EmptyLogText"
                       Grid.Column="0"
                       Text="Günlük boş. Yeni satırlar geldikçe burada görünür."
                       FontSize="13"
                       Foreground="{StaticResource Ink2}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Visibility="Collapsed"/>

            <Border Grid.Column="1"
                    Background="{StaticResource Ground}"
                    BorderBrush="{StaticResource Line}"
                    BorderThickness="1,0,0,0">
                <ScrollViewer x:Name="MetricsScroll"
                              Focusable="False"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="20,16,20,24">
                    <StackPanel x:Name="MetricsStack"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
