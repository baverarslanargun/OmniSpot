<Window x:Class="SmartFileLauncher.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:services="clr-namespace:SmartFileLauncher.UI.Services"
        mc:Ignorable="d"
        Title="OmniSpot" 
        Icon="/OmniSpot;component/Resources/app.ico"
        WindowStyle="None" 
        ResizeMode="NoResize" 
        Topmost="False"
        Background="#F8FAFF"
        ShowInTaskbar="True" 
        Focusable="True"
        WindowState="Normal" 
        Width="680" 
        Height="Auto" 
        SizeToContent="Height"
        MaxHeight="700"
        WindowStartupLocation="CenterScreen" 
        KeyDown="Window_KeyDown"
        xmlns:converters="clr-namespace:SmartFileLauncher.UI.Converters">
    
    <Window.Resources>
        <Style x:Key="IndexWaitGlint" TargetType="TextBlock">
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="OpacityMask">
                <Setter.Value>
                    <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="96,0">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#FF000000" Offset="0.5"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                        <LinearGradientBrush.Transform>
                            <TranslateTransform X="-10000"/>
                        </LinearGradientBrush.Transform>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SearchWaitGlint" TargetType="TextBlock" BasedOn="{StaticResource IndexWaitGlint}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True"/>
                        <Condition Binding="{Binding IsVisible, ElementName=SearchWatermark}" Value="True"/>
                        <Condition Binding="{Binding Enabled, Source={x:Static services:UiAnimationSettings.Current}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard Name="SearchGlint">
                            <Storyboard>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(TextBlock.OpacityMask).(Brush.Transform).(TranslateTransform.X)"
                                                               Duration="0:0:2.6" RepeatBehavior="Forever">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-96"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:1.2" Value="485">
                                        <EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction>
                                    </EasingDoubleKeyFrame>
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="SearchGlint"/>
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AiWaitGlint" TargetType="TextBlock" BasedOn="{StaticResource IndexWaitGlint}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True"/>
                        <Condition Binding="{Binding Enabled, Source={x:Static services:UiAnimationSettings.Current}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard Name="AiGlint">
                            <Storyboard>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(TextBlock.OpacityMask).(Brush.Transform).(TranslateTransform.X)"
                                                               Duration="0:0:2.6" RepeatBehavior="Forever">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-547"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:1.2" Value="34">
                                        <EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction>
                                    </EasingDoubleKeyFrame>
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="AiGlint"/>
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <converters:NotNullConverter x:Key="NotNullConverter"/>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Opacity" Value="0.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="12" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E2E8F0"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#CBD5E1"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#007AFF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="1"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Opacity" Value="1"/></Trigger>
            </Style.Triggers>
        </Style>
        <!-- Converters -->
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True"/>
        <converters:IconKindConverter x:Key="IconGlyph" Part="Glyph"/>
        <converters:IconKindConverter x:Key="IconLabel" Part="Label"/>
        <converters:IconKindConverter x:Key="IconColor" Part="Color"/>
        <converters:IconKindConverter x:Key="IconTint" Part="Tint"/>

        <Geometry x:Key="FolderBackGeometry">M3 7 a2 2 0 0 1 2 -2 h4.3 a2 2 0 0 1 1.4 0.6 l1.5 1.4 H19 a2 2 0 0 1 2 2 v9 a2 2 0 0 1 -2 2 H5 a2 2 0 0 1 -2 -2 z</Geometry>
        <Geometry x:Key="FolderFrontGeometry">M3 10.5 h18 v7.5 a2 2 0 0 1 -2 2 H5 a2 2 0 0 1 -2 -2 z</Geometry>
        <Geometry x:Key="FolderEdgeGeometry">M3 10.5 h18 v1.4 H3 z</Geometry>
        <Geometry x:Key="PageGeometry">M6 2 h8 l5 5 v13 a2 2 0 0 1 -2 2 H6 a2 2 0 0 1 -2 -2 V4 a2 2 0 0 1 2 -2 z</Geometry>
        <Geometry x:Key="PageFoldGeometry">M14 2 v4 a1 1 0 0 0 1 1 h4 z</Geometry>

        <DataTemplate x:Key="FolderIconTemplate">
            <Viewbox Stretch="Uniform" Margin="2">
                <Canvas Width="24" Height="24" RenderTransformOrigin="0.5,0.5">
                    <Canvas.RenderTransform><ScaleTransform ScaleX="1.2" ScaleY="1.2"/></Canvas.RenderTransform>
                    <Path Fill="{Binding FolderColor}" Data="{StaticResource FolderBackGeometry}"/>
                    <Path Fill="{Binding FolderColorLight}" Data="{StaticResource FolderFrontGeometry}"/>
                    <Path Fill="#FFFFFF" Opacity="0.35" Data="{StaticResource FolderEdgeGeometry}"/>
                </Canvas>
            </Viewbox>
        </DataTemplate>
        <DataTemplate x:Key="FileIconTemplate">
            <Grid x:Name="IconRoot">
                <Viewbox x:Name="Vector" Stretch="Uniform" Margin="2" Visibility="Collapsed">
                    <Grid Width="24" Height="24">
                        <Path Fill="{Binding Icon, Converter={StaticResource IconTint}}" Data="{StaticResource PageGeometry}"/>
                        <Path Fill="{Binding Icon, Converter={StaticResource IconColor}}" Opacity="0.55" Data="{StaticResource PageFoldGeometry}"/>
                        <Path Fill="{Binding Icon, Converter={StaticResource IconColor}}" Data="{Binding Icon, Converter={StaticResource IconGlyph}}"/>
                        <TextBlock Text="{Binding Icon, Converter={StaticResource IconLabel}}" Foreground="{Binding Icon, Converter={StaticResource IconColor}}"
                                   FontFamily="Segoe UI" FontSize="5.6" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3.2"/>
                    </Grid>
                </Viewbox>
                <Border x:Name="Img" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="3">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ThumbnailHasFrame}" Value="True">
                                    <Setter Property="BorderBrush" Value="#D5DCE6"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Background" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear"/>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                    <Setter TargetName="Img" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Vector" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Thumbnail, Converter={StaticResource NotNullConverter}}" Value="True"/>
                        <Condition Binding="{Binding ElementName=IconRoot, Path=(services:UiAnimationScope.ThumbnailFadeEnabled)}" Value="True"/>
                        <Condition Binding="{Binding Enabled, Source={x:Static services:UiAnimationSettings.Current}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Img" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
                        </Storyboard></BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <converters:ItemIconTemplateSelector x:Key="ItemIconSelector" Folder="{StaticResource FolderIconTemplate}" File="{StaticResource FileIconTemplate}"/>
        
        <!-- Modern shadow effect -->
        <DropShadowEffect x:Key="ModernShadow" 
                          BlurRadius="40" 
                          ShadowDepth="0" 
                          Opacity="0.4" 
                          Color="#000000"/>
        
        <!-- Subtle inner shadow for search box -->
        <DropShadowEffect x:Key="InnerShadow" 
                          BlurRadius="3" 
                          ShadowDepth="1" 
                          Opacity="0.15" 
                          Direction="270"
                          Color="#000000"/>
        
        <!-- Card hover shadow -->
        <DropShadowEffect x:Key="CardHoverShadow" 
                          BlurRadius="20" 
                          ShadowDepth="4" 
                          Opacity="0.15" 
                          Color="#000000"/>
        
        <!-- Folder Colors -->
        <SolidColorBrush x:Key="DocumentsColor" Color="#3B82F6"/>
        <SolidColorBrush x:Key="DownloadsColor" Color="#10B981"/>
        <SolidColorBrush x:Key="DesktopColor" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="MusicColor" Color="#EC4899"/>
        <SolidColorBrush x:Key="PicturesColor" Color="#F59E0B"/>
        <SolidColorBrush x:Key="VideosColor" Color="#EF4444"/>
        <SolidColorBrush x:Key="DefaultFolderColor" Color="#6366F1"/>
        <SolidColorBrush x:Key="FileColor" Color="#64748B"/>
        
        <!-- Folder Background Colors (lighter versions) -->
        <SolidColorBrush x:Key="DocumentsBg" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="DownloadsBg" Color="#ECFDF5"/>
        <SolidColorBrush x:Key="DesktopBg" Color="#F5F3FF"/>
        <SolidColorBrush x:Key="MusicBg" Color="#FDF2F8"/>
        <SolidColorBrush x:Key="PicturesBg" Color="#FFFBEB"/>
        <SolidColorBrush x:Key="VideosBg" Color="#FEF2F2"/>
        <SolidColorBrush x:Key="DefaultFolderBg" Color="#EEF2FF"/>
        <SolidColorBrush x:Key="FileBg" Color="#F8FAFC"/>
        
        <!-- Gradient backgrounds for main window -->
        <LinearGradientBrush x:Key="MainBackgroundGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F8FAFF" Offset="0"/>
            <GradientStop Color="#F0F4FF" Offset="0.5"/>
            <GradientStop Color="#EDF2FF" Offset="1"/>
        </LinearGradientBrush>
        
        <!-- Context Menu Style -->
        <Style x:Key="BannerTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="BannerDetail" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#5B6472"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>
        <Style x:Key="BannerIconPill" TargetType="Border">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="BannerCloseButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="Foreground" Value="#5B6472"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="8" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#14000000"/>
                                <Setter Property="Foreground" Value="#111827"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#22000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Geometry x:Key="CloseGlyphGeometry">M0 0 L8 8 M8 0 L0 8</Geometry>
        <Geometry x:Key="MinusGlyphGeometry">M0 4 L8 4</Geometry>
        <Geometry x:Key="SyncGeometry">M4 12 A8 8 0 0 1 18 6.7 M20 12 A8 8 0 0 1 6 17.3 M18 3 V7 H14 M6 21 V17 H10</Geometry>
        <Geometry x:Key="InfoGeometry">M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 M12 11 V16 M12 8 V8.1</Geometry>
        <Geometry x:Key="WarningTriangleGeometry">M12 2.5 L22.5 20.5 H1.5 Z</Geometry>
        <Geometry x:Key="WarningMarkGeometry">M12 9 V14.2 M12 17.2 V17.3</Geometry>
        <Style x:Key="StateTile" TargetType="Border">
            <Setter Property="Width" Value="104"/>
            <Setter Property="Height" Value="104"/>
            <Setter Property="CornerRadius" Value="30"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D6E2F6"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F3F7FE" Offset="0"/>
                        <GradientStop Color="#E3ECFB" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="6" Opacity="0.10" Color="#2B5CB8"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StateTileWarm" TargetType="Border" BasedOn="{StaticResource StateTile}">
            <Setter Property="BorderBrush" Value="#F5D9D5"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFF6F4" Offset="0"/>
                        <GradientStop Color="#FBE7E4" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="6" Opacity="0.10" Color="#B8412B"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StateBadge" TargetType="Border">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D6E2F6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>
        <Style x:Key="StateTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MaxWidth" Value="380"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="StateHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Foreground" Value="#5B6472"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MaxWidth" Value="380"/>
        </Style>
        <Style x:Key="StateGhostButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Foreground" Value="#2F4A73"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="10" Background="#FFFFFF" BorderBrush="#D6DEEA" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#F3F7FE"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#B9CCEC"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#E3ECFB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatePrimaryButton" TargetType="Button" BasedOn="{StaticResource StateGhostButton}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="10" Background="#3F7EE8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#3470D6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#2B62BE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Geometry x:Key="MagnifierGeometry">M10 4 A6 6 0 1 0 10 16 A6 6 0 1 0 10 4 M14.5 14.5 L20 20</Geometry>
        <Style x:Key="ModernScrollThumb" TargetType="Thumb">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbSurface" Background="#B9C2CF" CornerRadius="3" Margin="2" Opacity="0.75"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Background" Value="#8E99A8"/>
                                <Setter TargetName="ThumbSurface" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbSurface" Property="Background" Value="#6B7684"/>
                                <Setter TargetName="ThumbSurface" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModernScrollPage" TargetType="RepeatButton">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="0,4,0,4">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ModernScrollPage}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ModernScrollPage}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernScrollThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0"/>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="MinHeight" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent" Margin="4,0,4,0">
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ModernScrollPage}"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ModernScrollPage}"/>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ModernScrollThumb}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModernContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.15" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Context Menu Item Style -->
        <Style x:Key="ModernMenuItem" TargetType="MenuItem">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border" 
                                Background="Transparent" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" 
                                           Text="{TemplateBinding Tag}" 
                                           FontSize="14"
                                           VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" 
                                                  ContentSource="Header" 
                                                  VerticalAlignment="Center"
                                                  Margin="8,0,16,0"/>
                                <TextBlock Grid.Column="2" 
                                           Text="{TemplateBinding InputGestureText}" 
                                           Foreground="#94A3B8"
                                           FontSize="11"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
