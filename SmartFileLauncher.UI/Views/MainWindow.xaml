                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="CardBorder" Property="Background" Value="#F8FAFC"/>
                                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#CBD5E1"/>
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsTransferSelected}" Value="True">
                                                                <Setter TargetName="CardBorder" Property="Background" Value="#EFF6FF"/>
                                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#007AFF"/>
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel HorizontalAlignment="Center" Width="100">
                                        <!-- Modern Icon Container with colored background -->
                                        <Border Width="72" Height="72"
                                                Margin="0,0,0,12"
                                                CornerRadius="16"
                                                HorizontalAlignment="Center">
                                            <ContentPresenter Content="{Binding}" ContentTemplateSelector="{StaticResource ItemIconSelector}" Width="56" Height="56"/>
                                        </Border>

                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Foreground="#334155"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="36"
                                                   LineHeight="16"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>

        <DataTemplate x:Key="DesktopRowTemplate">
            <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="4,2" Padding="0"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Opacity="{Binding Opacity}" ToolTip="{Binding FullPath}" Tag="{Binding FullPath}"
                    Click="DesktopIcon_Click" ContextMenu="{StaticResource FileContextMenu}"
                    MouseRightButtonDown="FileItem_RightClick" MouseEnter="FileItem_MouseEnter" MouseLeave="FileItem_MouseLeave">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Row" Background="White" CornerRadius="12" Padding="12,10" BorderBrush="#E2E8F0" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="Row" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Row" Property="BorderBrush" Value="#007AFF"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsTransferSelected}" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="Row" Property="BorderBrush" Value="#007AFF"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Content="{Binding}" ContentTemplateSelector="{StaticResource ItemIconSelector}" Width="30" Height="30" Margin="0,0,14,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding FullPath}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="DesktopGridRowTemplate">
            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource DesktopCardTemplate}" HorizontalAlignment="Center" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>
        <DataTemplate x:Key="DesktopListRowTemplate">
            <ContentPresenter Content="{Binding Items[0]}" ContentTemplate="{StaticResource DesktopRowTemplate}"/>
        </DataTemplate>
    </Window.Resources>
    
    <Border x:Name="Shell" Background="{StaticResource MainBackgroundGradient}"
            CornerRadius="8"
            Padding="0"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/> <!-- Delta Sync Progress Row -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="DualPane"
                    Grid.Column="1"
                    Grid.RowSpan="5"
                    Width="460"
                    Visibility="Collapsed"
                    Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1,0,0,0"
                    CornerRadius="0,8,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="18,16,12,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Karşı panel" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource SelectionBarButton}" Content="⇄  Yer değiştir"
                                ToolTip="Soldaki ve sağdaki klasörü yer değiştir" Click="DualPaneSwap_Click"/>
                        <Button Grid.Column="2" Style="{StaticResource TabCloseButton}" Margin="8,0,0,0" VerticalAlignment="Center"
                                ToolTip="Çift paneli kapat (Ctrl+Shift+D)" AutomationProperties.Name="Çift paneli kapat" Click="DualPaneClose_Click"/>
                    </Grid>
                    <StackPanel x:Name="DualPanePath" Grid.Row="1" Orientation="Horizontal" Margin="12,0,14,6" Height="28" ClipToBounds="True"/>
                    <ListBox x:Name="DualPaneList"
                             Grid.Row="2"
                             SelectionMode="Extended"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="8,0,8,8"
                             MaxHeight="560"
                             AllowDrop="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Row" Background="Transparent" CornerRadius="8" Padding="10,6">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="#F8FAFC"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="#EAF1FD"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding Path}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Canvas.Style>
                                                <Style TargetType="Canvas">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Canvas.Style>
                                            <Path Fill="#3F7EE8" Data="{StaticResource FolderBackGeometry}"/>
                                            <Path Fill="#6FA4F7" Data="{StaticResource FolderFrontGeometry}"/>
                                        </Canvas>
                                    </Viewbox>
                                    <Path Data="M 3,1 H 10 L 14,5 V 17 H 3 Z M 10,1 V 5 H 14" Stroke="#94A3B8" StrokeThickness="1.3"
                                          StrokeLineJoin="Round" Width="18" Height="18" Stretch="None" VerticalAlignment="Center">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" Foreground="#1E293B" Margin="10,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="DualPaneEmpty" Grid.Row="2" Text="Bu klasör boş" FontSize="13" Foreground="#94A3B8"
                               HorizontalAlignment="Center" Margin="0,40,0,40" Visibility="Collapsed"/>
                    <Border Grid.Row="3" BorderBrush="#EEF2F7" BorderThickness="0,1,0,0" Padding="18,8,12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DualPaneStatusText" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="DualPaneCopyLeftButton" Style="{StaticResource SelectionBarButton}" Content="← Sola kopyala"
                                        Click="DualPaneCopyLeft_Click"/>
                                <Button x:Name="DualPaneMoveLeftButton" Style="{StaticResource SelectionBarButton}" Content="← Sola taşı"
                                        Click="DualPaneMoveLeft_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="TabStrip" Grid.Row="0" Visibility="Collapsed" Padding="14,8,14,0">
                <StackPanel x:Name="TabStripItems" Orientation="Horizontal" VerticalAlignment="Bottom" ClipToBounds="True"/>
            </Border>

            <!-- Search Box Area -->
            <Border x:Name="SearchHeader"
                    Grid.Row="1"
                    CornerRadius="8,8,0,0"
                    Padding="20,16,20,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFFFFF" Offset="0"/>
                        <GradientStop Color="#FAFBFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Back Button -->
                        <ColumnDefinition Width="*"/> <!-- Search Container -->
                        <ColumnDefinition Width="Auto"/> <!-- Action Buttons -->
                    </Grid.ColumnDefinitions>
                    
                    <!-- Back Button (Navigation) -->
                    <Button x:Name="BackButton"
                            Grid.Column="0"
                            Style="{StaticResource HeaderNavButton}"
                            Margin="0,0,12,0"
                            Visibility="Collapsed"
                            Click="BackButton_Click"
                            AutomationProperties.Name="Geri"
                            ToolTip="Geri (Alt+←)"/>

                    <!-- Modern Search Container -->
                    <Border Grid.Column="1" 
                            Background="#F1F5F9"
                            CornerRadius="12"
                            Padding="16,8"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06" Color="#000000" Direction="270"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- Search Icon -->
                                <ColumnDefinition Width="*"/> <!-- Search Input -->
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Modern Search Icon -->
                            <Viewbox Grid.Column="0" Width="20" Height="20" Margin="0,0,12,0" Opacity="0.5">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#64748B" 
                                          Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                                </Canvas>
                            </Viewbox>
                            
                            <!-- Search Input with Watermark -->
                            <Grid Grid.Column="1">
                                <TextBlock x:Name="SearchWatermark" 
                                           Text="Dosya veya klasör ara..."
                                           FontSize="16" 
                                           Foreground="#94A3B8" 
                                           VerticalAlignment="Center" 
                                           IsHitTestVisible="False"
                                           FontWeight="Normal"
                                           Visibility="Visible"/>
                                <TextBlock x:Name="SearchWaitShimmer"
                                           Text="{Binding Text, ElementName=SearchWatermark}"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource SearchWaitGlint}"
                                           Visibility="Collapsed"/>

                                <TextBox x:Name="SearchBox"
                                         IsEnabled="False"
                                         FontSize="16" 
                                         Background="Transparent" 
                                         Foreground="#1E293B" 
                                         BorderThickness="0" 
                                         CaretBrush="#6366F1"
                                         VerticalContentAlignment="Center"
                                         FontWeight="Normal"
                                         Padding="0"/>
                            </Grid>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock x:Name="SearchLatencyText"
                                       Text="— ms" FontFamily="Consolas" FontSize="10"
                                       Foreground="#64748B" VerticalAlignment="Center"
                                       TextAlignment="Right" MinWidth="48" Margin="10,0,0,0"
                                       Visibility="Collapsed"
                                       AutomationProperties.Name="Arama süresi"/>
                            <TextBlock x:Name="BackgroundIndexStatus" Text="AI hazırlanıyor"
                                       FontSize="9" Foreground="#64748B" TextAlignment="Right"
                                       Margin="10,2,0,0" Visibility="Collapsed"
                                       ToolTip="Dosya araması hazır. AI ve gelişmiş arama indeksi arka planda hazırlanıyor."/>
                            </StackPanel>

                            <Grid Grid.Column="3">
                                <Border x:Name="FilterBadge"
                                        Visibility="Collapsed"
                                        Background="#E4EDFB"
                                        BorderBrush="#C6D8F4"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="8,3"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="FilterBadge_MouseLeftButtonDown"
                                        MouseEnter="FilterBadge_MouseEnter"
                                        MouseLeave="FilterBadge_MouseLeave">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M 1.5,2.5 H 12.5 L 8.3,7.2 V 11.5 L 5.7,10.2 V 7.2 Z"
                                              Stroke="#3F7EE8" StrokeThickness="1.3" StrokeLineJoin="Round"
                                              Width="14" Height="14" Stretch="None"
                                              VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="FilterBadgeText" Text=""
                                                   FontSize="12" FontWeight="Medium" Foreground="#2F62BF"
                                                   VerticalAlignment="Center"/>
                                        <Button x:Name="FilterBadgeClear"
                                                Style="{StaticResource ChipCloseButton}"
                                                Click="FilterBadgeClear_Click"
                                                ToolTip="Tüm filtreleri temizle"
                                                Margin="6,0,-2,0"
                                                VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Popup x:Name="FilterBadgePopup"
                                       PlacementTarget="{Binding ElementName=FilterBadge}"
                                       Placement="Bottom"
                                       VerticalOffset="6"
                                       HorizontalOffset="-6"
                                       AllowsTransparency="True"
                                       StaysOpen="True"
                                       PopupAnimation="{Binding PopupAnimation, Source={x:Static services:UiAnimationSettings.Current}}"
                                       Closed="FilterBadgePopup_Closed">
                                    <Border Background="White"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="6"
                                            Margin="0,0,12,12"
                                            MouseEnter="FilterBadgePopup_MouseEnter"
                                            MouseLeave="FilterBadgePopup_MouseLeave">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.15" Color="#000000"/>
                                        </Border.Effect>
                                        <StackPanel MinWidth="170">
                                            <TextBlock Text="Etkin filtreler" FontSize="11" Foreground="#94A3B8"
                                                       Margin="8,2,8,6"/>
                                            <ItemsControl x:Name="FilterChips">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Label}"
                                                                       FontSize="12.5" Foreground="#334155"
                                                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                            <Button Grid.Column="1"
                                                                    Style="{StaticResource ChipCloseButton}"
                                                                    Click="FilterChipRemove_Click"
                                                                    ToolTip="Bu filtreyi kaldır"
                                                                    Margin="12,0,2,0"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Border Height="1" Background="#E2E8F0" Margin="6,6,6,4"/>
                                            <Button Click="FilterBadgeClear_Click"
                                                    Style="{StaticResource ChipClearAllButton}">
                                                <TextBlock Text="Hepsini temizle" FontSize="12.5" Foreground="#475569"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Grid>
                    </Border>
                    
                    <!-- Action Buttons Container -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                    
                    <!-- Natural Language Toggle -->
                    <StackPanel x:Name="AiControls" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Grid>
                    <ToggleButton x:Name="NaturalLanguageToggle"
                                  IsEnabled="False"
                                  FontSize="11"
                                  FontWeight="SemiBold"
                                  Padding="12,0"
                                  Height="40"
                                  Margin="0"
                                  Background="#F1F5F9"
                                  Foreground="#64748B"
                                  BorderThickness="0"
                                  Cursor="Hand"
                                  VerticalAlignment="Center"
                                  ToolTipService.ShowOnDisabled="True">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="ToolTip" Value="AI destekli doğal dil araması"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="12"
                                                    Padding="{TemplateBinding Padding}"
                                                    BorderBrush="#E2E8F0"
                                                    BorderThickness="1">
                                                <TextBlock x:Name="content"
                                                           Text="🤖 AI"
                                                           Foreground="{TemplateBinding Foreground}"
                                                           FontSize="{TemplateBinding FontSize}"
                                                           FontWeight="{TemplateBinding FontWeight}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#007AFF"/>
                                                    <Setter TargetName="content" Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                        <Condition Property="IsChecked" Value="False"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="border" Property="Background" Value="#E8E8ED"/>
                                                </MultiTrigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="True"/>
                                                        <Condition Property="IsChecked" Value="True"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="border" Property="Background" Value="#0066DD"/>
                                                </MultiTrigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="border" Property="Background" Value="#E8E8E8"/>
                                                    <Setter TargetName="content" Property="Foreground" Value="#AAAAAA"/>
                                                    <Setter Property="Cursor" Value="No"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <TextBlock x:Name="AiWaitShimmer" Text="🤖 AI" FontSize="11" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Style="{StaticResource AiWaitGlint}" Visibility="Collapsed"/>
                    </Grid>
                    <Button x:Name="AiEffortButton" Height="40"
                            IsEnabled="False"
                            Click="AiEffortButton_Click" AutomationProperties.Name="AI eforu: Medium">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
                                <Setter Property="Width" Value="44"/>
                                <Setter Property="Margin" Value="4,0,0,0"/>
                                <Setter Property="Opacity" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=NaturalLanguageToggle}" Value="False">
                                        <Setter Property="IsHitTestVisible" Value="False"/>
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="Width" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="Opacity" Value="0"/>
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsChecked, ElementName=NaturalLanguageToggle}" Value="False"/>
                                            <Condition Binding="{Binding Enabled, Source={x:Static services:UiAnimationSettings.Current}}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard FillBehavior="Stop">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.14"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="Width" From="44" To="0" Duration="0:0:0.18">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <ThicknessAnimation Storyboard.TargetProperty="Margin" From="4,0,0,0" To="0" Duration="0:0:0.18"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </MultiDataTrigger.EnterActions>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsChecked, ElementName=NaturalLanguageToggle}" Value="True"/>
                                            <Condition Binding="{Binding Enabled, Source={x:Static services:UiAnimationSettings.Current}}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard FillBehavior="Stop">
                                                    <DoubleAnimation Storyboard.TargetProperty="Width" From="0" To="44" Duration="0:0:0.18">
                                                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0" To="4,0,0,0" Duration="0:0:0.18"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.06" Duration="0:0:0.14"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </MultiDataTrigger.EnterActions>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0">
                            <Canvas Width="24" Height="15">
                                <Path Data="M 3,14 A 9,9 0 1 1 21,14" Stroke="#94A3B8" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Path Data="M 4.5,6.5 L 6.3,7.6 M 12,2.6 L 12,4.6 M 19.5,6.5 L 17.7,7.6" Stroke="#CBD5E1" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Line X1="12" Y1="13" X2="12" Y2="5.5" Stroke="#007AFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                    <Line.RenderTransform><RotateTransform x:Name="AiEffortNeedle" CenterX="12" CenterY="13"/></Line.RenderTransform>
                                </Line>
                                <Ellipse Canvas.Left="10" Canvas.Top="11" Width="4" Height="4" Fill="#007AFF"/>
                            </Canvas>
                            <TextBlock x:Name="AiEffortLabel" Text="Medium" FontSize="8" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Button>
                    </StackPanel>
                    
                    <!-- Debug Console Toggle -->
                    <Button x:Name="ConsoleToggleButton"
                            Content="🐞"
                            FontSize="14" 
                            Width="40"
                            Height="40"
                            Margin="0,0,4,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            VerticalAlignment="Center"
                            ToolTip="Debug Konsolu">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Opacity" Value="0.5"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border"
                                                    Background="#F1F5F9"
                                                    CornerRadius="12"
                                                    BorderBrush="#E2E8F0"
                                                    BorderThickness="1">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#E2E8F0"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#CBD5E1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- More Options (view switch + settings) -->
                    <Button x:Name="MoreOptionsButton" Width="40" Height="40" Margin="0,0,4,0"
                            ToolTip="Görünüm ve ayarlar"
                            AutomationProperties.Name="Diğer seçenekler" Click="MoreOptionsButton_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource Self}}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                        <Setter Property="Background" Value="#E2E8F0"/>
                                        <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="3.5" Height="3.5" Fill="#64748B" Margin="1.5,0"/>
                            <Ellipse Width="3.5" Height="3.5" Fill="#64748B" Margin="1.5,0"/>
                            <Ellipse Width="3.5" Height="3.5" Fill="#64748B" Margin="1.5,0"/>
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu Placement="Bottom" HorizontalOffset="-160" VerticalOffset="6" MinWidth="196"
                                         Background="White" Foreground="#334155" FontSize="12" BorderBrush="#E2E8F0" BorderThickness="1">
                                <ContextMenu.Template>
                                    <ControlTemplate TargetType="ContextMenu">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="5">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </Border>
                                    </ControlTemplate>
                                </ContextMenu.Template>
                                <ContextMenu.Resources>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Padding" Value="9,7"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="MenuItem">
                                                    <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#F1F5F9"/></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ContextMenu.Resources>
                                <MenuItem x:Name="ViewModeMenuItem" StaysOpenOnClick="True" Click="ViewModeMenuItem_Click"
                                          AutomationProperties.Name="Görünüm: Liste. Grid görünümüne geç">
                                    <MenuItem.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <AccessText Text="_Görünüm" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Width="60" Height="26" CornerRadius="13" Background="#E2E8F0" Margin="16,0,0,0">
                                                <Grid>
                                                    <Border x:Name="ViewModeThumb" Width="28" Height="22" CornerRadius="11" Background="White"
                                                            HorizontalAlignment="Left" Margin="2,0,0,0">
                                                        <Border.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="0.5" Opacity="0.18" Color="#0F172A"/></Border.Effect>
                                                        <Border.RenderTransform><TranslateTransform x:Name="ViewModeThumbShift"/></Border.RenderTransform>
                                                    </Border>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Path x:Name="ViewModeListIcon" Data="M 1,1.5 H 13 M 1,6 H 13 M 1,10.5 H 13" Stroke="#007AFF" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" Width="14" Height="12" Stretch="None"/>
                                                        <Path x:Name="ViewModeGridIcon" Grid.Column="1" Data="M 1,1 H 5.5 V 5.5 H 1 Z M 8.5,1 H 13 V 5.5 H 8.5 Z M 1,8.5 H 5.5 V 13 H 1 Z M 8.5,8.5 H 13 V 13 H 8.5 Z"
                                                              Stroke="#94A3B8" StrokeThickness="1.5" StrokeLineJoin="Round"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center" Width="14" Height="14" Stretch="None"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <Separator Margin="6,3"/>
                                <MenuItem Click="NewTabMenuItem_Click" AutomationProperties.Name="Yeni sekme">
                                    <MenuItem.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <AccessText Text="Yeni _sekme" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="Ctrl+T" FontSize="11" Foreground="#94A3B8" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Click="DualPaneMenuItem_Click" AutomationProperties.Name="Çift panel">
                                    <MenuItem.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <AccessText Text="Çift _panel" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="DualPaneCheck" Text="  ✓" Foreground="#3F7EE8" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Visibility="Collapsed"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="Ctrl+Shift+D" FontSize="11" Foreground="#94A3B8" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </MenuItem.Header>
                                </MenuItem>
                                <Separator Margin="6,3"/>
                                <MenuItem Header="_Ayarlar" Click="SettingsButton_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    
                    <!-- Close Button -->
                    <Button x:Name="CloseButton"
                            Content="✕" 
                            FontSize="14" 
                            Width="40"
                            Height="40"
                            Margin="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            VerticalAlignment="Center"
                            ToolTip="Kapat"
                            Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Opacity" Value="0.5"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="border" 
                                                    Background="#F1F5F9"
                                                    CornerRadius="12"
                                                    BorderBrush="#E2E8F0"
                                                    BorderThickness="1">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FEE2E2"/>
                                                    <Setter TargetName="border" Property="BorderBrush" Value="#FECACA"/>
                                                    <Setter Property="Foreground" Value="#DC2626"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#FECACA"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    </StackPanel> <!-- Action Buttons Container end -->
                </Grid>
            </Border>
            
            <!-- Results Area -->
            <Grid x:Name="FileContentArea" Grid.Row="2" Margin="0" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid x:Name="FolderPathBar" Grid.Row="0" Margin="16,8,24,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="FolderPathSegments" Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True"/>
                    <TextBlock x:Name="FolderItemCountText" Grid.Column="1" FontSize="12" Foreground="#94A3B8"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
                <!-- Desktop Icons (Hidden by default in Spotlight style) -->
                <Border x:Name="DesktopIconsScroll"
                        Grid.Row="1"
                        Visibility="Collapsed"
                        Background="Transparent"
                        MaxHeight="500"
                        ContextMenu="{StaticResource EmptyAreaContextMenu}"
                        MouseRightButtonDown="EmptyArea_RightClick">
                    <ListBox x:Name="DesktopIcons"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="20,12,20,20"
                             Focusable="False"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Visible"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ItemTemplate="{StaticResource DesktopGridRowTemplate}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>

                <!-- Search Results List -->
                <Border x:Name="ResultsContainer"
                        Grid.Row="1"
                        services:UiAnimationScope.ThumbnailFadeEnabled="False"
                        Background="Transparent"
                        CornerRadius="0,0,8,8"
                        Visibility="Collapsed">
                    
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="356"/>
                        </Grid.RowDefinitions>
                        
                        <!-- AI Fallback Warning Banner - En üstte, her zaman görünür -->
                        <Border x:Name="FallbackWarningBanner"
                                Grid.Row="0"
                                Background="#FFF7E8"
                                BorderBrush="#F3E2BF"
                                BorderThickness="0,0,0,1"
                                Padding="14,9"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource BannerIconPill}" Background="#FBE9C3">
                                    <Grid Width="16" Height="15">
                                        <Path Data="{StaticResource WarningTriangleGeometry}" Fill="#D98A0C" Stroke="#D98A0C" StrokeThickness="2" StrokeLineJoin="Round" Stretch="Uniform"/>
                                        <Path Data="{StaticResource WarningMarkGeometry}" Stroke="#FFFFFF" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="2.2" Height="6.4" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,3,0,0"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="AI kullanılamadı, standart arama kullanıldı" Style="{StaticResource BannerTitle}"/>
                                    <TextBlock x:Name="FallbackReasonText" Text="" Style="{StaticResource BannerDetail}"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource BannerCloseButton}" Click="CloseFallbackBanner_Click" ToolTip="Kapat">
                                    <Path Data="{StaticResource CloseGlyphGeometry}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="8" Height="8" Stretch="None"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Delta Sync Warning Banner (during search) -->
                        <Border x:Name="DeltaSyncWarningBanner"
                                Grid.Row="0"
                                Background="#EEF4FF"
                                BorderBrush="#D6E2F6"
                                BorderThickness="0,0,0,1"
                                Padding="14,9"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource BannerIconPill}" Background="#DCE7FB">
                                    <Path Data="{StaticResource InfoGeometry}" Stroke="#3F7EE8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="16" Height="16" Stretch="Uniform"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Değişiklikler hâlâ taranıyor" Style="{StaticResource BannerTitle}"/>
                                    <TextBlock x:Name="DeltaSyncWarningText" Text="Daha iyi sonuçlar için birkaç saniye bekleyin" Style="{StaticResource BannerDetail}"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource BannerCloseButton}" Click="CloseDeltaSyncBanner_Click" ToolTip="Kapat">
                                    <Path Data="{StaticResource CloseGlyphGeometry}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="8" Height="8" Stretch="None"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Content Area (Row 1) -->
                        <Grid Grid.Row="1">
                            <!-- Searching Indicator -->
                            <StackPanel x:Name="SearchingPanel"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="40,32">
                                <Grid Width="104" Height="104" HorizontalAlignment="Center" Margin="0,0,0,22">
                                    <Border Style="{StaticResource StateTile}"/>
                                    <Path Data="{StaticResource MagnifierGeometry}" Stroke="#3F7EE8" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="46" Height="46" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="SearchingText" Text="Aranıyor…" Style="{StaticResource StateTitle}"/>
                            </StackPanel>

                            <!-- Error Panel -->
                            <StackPanel x:Name="ErrorPanel"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="40,32">
                                <Grid Width="104" Height="104" HorizontalAlignment="Center" Margin="0,0,0,22">
                                    <Border Style="{StaticResource StateTileWarm}"/>
                                    <Grid Width="50" Height="46" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="M12 2.5 L22.5 20.5 H1.5 Z" Fill="#EF6A55" Stretch="Uniform" StrokeLineJoin="Round" Stroke="#EF6A55" StrokeThickness="2"/>
                                        <Path Data="M12 9 V14.2 M12 17.2 V17.3" Stroke="#FFFFFF" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="6" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                    </Grid>
                                </Grid>
                                <TextBlock x:Name="ErrorTitle" Text="Bir hata oluştu" Style="{StaticResource StateTitle}"/>
                                <TextBlock x:Name="ErrorMessage" Text="" Style="{StaticResource StateHint}" Margin="0,0,0,18"/>
                                <Button x:Name="RetryButton" Content="Tekrar dene" Style="{StaticResource StatePrimaryButton}" Click="RetryButton_Click"/>
                            </StackPanel>

                            <!-- No Results Message -->
                            <StackPanel x:Name="NoResultsPanel"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="40,32">
                                <Grid Width="104" Height="104" HorizontalAlignment="Center" Margin="0,0,0,22">
                                    <Border Style="{StaticResource StateTile}"/>
                                    <Path Data="{StaticResource MagnifierGeometry}" Stroke="#3F7EE8" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="46" Height="46" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource StateBadge}">
                                        <Path Data="M0 0 L8 8 M8 0 L0 8" Stroke="#3F7EE8" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Width="8" Height="8" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <TextBlock Text="Sonuç bulunamadı" Style="{StaticResource StateTitle}"/>
                                <TextBlock x:Name="NoResultsHint" Text="Farklı anahtar kelimeler deneyin" Style="{StaticResource StateHint}"/>
                            </StackPanel>
                        </Grid>
                        
                        <!-- List View - Modern Design -->
                        <ListView x:Name="ResultsList"
                                  ItemsSource="{Binding SearchResults}"
                                  Grid.Row="1"
                                  Background="Transparent" 
                                  BorderThickness="0" 
                                  SelectionMode="Extended"
                                  Padding="12,4,12,12"
                                  MaxHeight="500"
                                  ScrollViewer.VerticalScrollBarVisibility="Visible"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  VirtualizingPanel.ScrollUnit="Pixel"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="ContextMenu" Value="{StaticResource FileContextMenu}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border x:Name="border"
                                                        Background="White"
                                                        CornerRadius="12"
                                                        Margin="4,4"
                                                        Padding="12,10"
                                                        BorderBrush="#E2E8F0"
                                                        BorderThickness="1">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#F8FAFC"/>
                                                        <Setter TargetName="border" Property="BorderBrush" Value="#CBD5E1"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#6366F1"/>
                                                        <Setter TargetName="border" Property="BorderBrush" Value="#6366F1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsCut}" Value="True">
                                            <Setter Property="Opacity" Value="0.5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Thumbnail veya Icon - Modern Style -->
                                        <Border Grid.Column="0"
                                                Width="44" Height="44"
                                                CornerRadius="10"
                                                Margin="0,0,14,0"
                                                VerticalAlignment="Center">
                                            <ContentPresenter Content="{Binding}" ContentTemplateSelector="{StaticResource ItemIconSelector}" Width="30" Height="30"/>
                                        </Border>
                                        
                                        <!-- File Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" 
                                                       FontSize="14" 
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#1E293B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsSelected}" Value="True">
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding FullPath}" 
                                                       FontSize="11" 
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,3,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsSelected}" Value="True">
                                                                <Setter Property="Foreground" Value="#E0E7FF"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        
                                        <!-- Score Badge -->
                                        <Border Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Margin="12,0,0,0"
                                                Padding="8,4"
                                                CornerRadius="8">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#F1F5F9"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="#4F46E5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Score, StringFormat='{}{0:F0}'}" 
                                                       FontSize="10"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsSelected}" Value="True">
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    
                    <!-- Grid View - Modern Design -->
                    <ScrollViewer x:Name="ResultsGridScroll"
                                 Grid.Row="1"
                                 VerticalScrollBarVisibility="Visible"
                                 MaxHeight="500"
                                 Visibility="Collapsed"
                                 Background="Transparent">
                        <ItemsControl x:Name="ResultsGrid"
                                     ItemsSource="{Binding ElementName=ResultsList, Path=ItemsSource}"
                                     Margin="16,8,16,16"
                                     HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Width="616"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Background="Transparent" 
                                            BorderThickness="0" 
                                            Cursor="Hand" 
                                            Margin="10,10"
                                            Padding="0"
                                            Tag="{Binding FullPath}"
                                            Click="GridItem_Click"
                                            ContextMenu="{StaticResource FileContextMenu}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCut}" Value="True">
                                                        <Setter Property="Opacity" Value="0.5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="CardBorder" 
                                                                    Background="White"
                                                                    CornerRadius="16"
                                                                    Padding="16,20,16,16"
                                                                    BorderBrush="#E2E8F0"
                                                                    BorderThickness="1"
                                                                    RenderTransformOrigin="0.5,0.5">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="CardBorder" Property="Background" Value="#F8FAFC"/>
                                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#CBD5E1"/>
                                                                </Trigger>
                                                                <DataTrigger Binding="{Binding IsTransferSelected}" Value="True">
                                                                    <Setter TargetName="CardBorder" Property="Background" Value="#EFF6FF"/>
                                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="#007AFF"/>
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel HorizontalAlignment="Center" Width="100">
                                            <!-- Modern Icon Container -->
                                            <Border Width="72" Height="72" 
                                                    Margin="0,0,0,12"
                                                    CornerRadius="16"
                                                    HorizontalAlignment="Center">
                                                <ContentPresenter Content="{Binding}" ContentTemplateSelector="{StaticResource ItemIconSelector}" Width="56" Height="56"/>
                                            </Border>
                                            
                                            <!-- File Name -->
                                            <TextBlock Text="{Binding Name}" 
                                                       FontSize="12"
                                                       FontWeight="Medium"
                                                       Foreground="#334155"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="36"
                                                       LineHeight="16"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    </Grid>
                </Border>
                
                <!-- Folder Loading Indicator (Improved - more spacious) -->
                <ProgressBar x:Name="FolderLoadingBar" Grid.RowSpan="2" Height="2" VerticalAlignment="Top" Margin="0" Panel.ZIndex="5"
                             Visibility="Collapsed" IsIndeterminate="False" Foreground="#007AFF" Background="Transparent" BorderThickness="0"/>
                <!-- Empty Folder Message -->
                <Border x:Name="EmptyFolderPanel"
                        Grid.Row="1"
                        Background="Transparent"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        ContextMenu="{StaticResource EmptyAreaContextMenu}"
                        Padding="40,32">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="104" Height="104" HorizontalAlignment="Center" Margin="0,0,0,22">
                            <Border CornerRadius="30" BorderThickness="1" BorderBrush="#D6E2F6">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#F3F7FE" Offset="0"/>
                                        <GradientStop Color="#E3ECFB" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="6" Opacity="0.10" Color="#2B5CB8"/>
                                </Border.Effect>
                            </Border>
                            <Viewbox Width="54" Height="54">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#3F7EE8" Data="{StaticResource FolderBackGeometry}"/>
                                    <Path Fill="#6FA4F7" Data="{StaticResource FolderFrontGeometry}"/>
                                    <Path Fill="#FFFFFF" Opacity="0.4" Data="{StaticResource FolderEdgeGeometry}"/>
                                </Canvas>
                            </Viewbox>
                            <Border Width="30" Height="30" CornerRadius="15" Background="#FFFFFF" BorderBrush="#D6E2F6" BorderThickness="1"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10">
                                <Path Data="M4 0 L4 8 M0 4 L8 4" Stroke="#3F7EE8" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="8" Height="8" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="EmptyFolderTitle"
                                   Text="Klasör boş"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="380"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="Bu klasörde henüz dosya yok."
                                   FontSize="13.5"
                                   Foreground="#5B6472"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="380"
                                   Margin="0,0,0,18"/>
                        <Button x:Name="EmptyFolderBackButton"
                                Click="EmptyFolderUpButton_Click"
                                Cursor="Hand"
                                Focusable="False"
                                HorizontalAlignment="Center"
                                Padding="16,8">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Surface" CornerRadius="10" Background="#FFFFFF" BorderBrush="#D6DEEA" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M9 1 L4 6 L9 11 M4 6 L14 6" Stroke="#2F4A73" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="14" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Üst klasöre dön" FontSize="13" FontWeight="SemiBold" Foreground="#2F4A73" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Surface" Property="Background" Value="#F3F7FE"/>
                                            <Setter TargetName="Surface" Property="BorderBrush" Value="#B9CCEC"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Surface" Property="Background" Value="#E3ECFB"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,12" Panel.ZIndex="6">
                    <Button x:Name="ShelfChip"
                            Visibility="Collapsed"
                            Cursor="Hand"
                            Focusable="False"
                            BorderBrush="{StaticResource ShelfLineBrush}"
                            Click="ShelfChip_Click"
                            AutomationProperties.Name="Raf"
                            ToolTip="Raf: farklı yerlerden topladığın öğeler. Bir klasöre git, hepsini oraya kopyala ya da taşı. Öğeleri buraya sürükleyerek de ekleyebilirsin.">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Surface" Background="#FFFFFF" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="1" CornerRadius="16" Padding="12,6,7,6">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.10" Color="#0F172A"/>
                                    </Border.Effect>
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Surface" Property="Background" Value="#F8FAFC"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 1,6 H 4.5 L 6,8.5 H 10 L 11.5,6 H 15 V 13.5 H 1 Z M 3,3.5 H 13 M 4.5,1 H 11.5"
                                  Stroke="#475569" StrokeThickness="1.3" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="16" Height="15" Stretch="None" VerticalAlignment="Center"/>
                            <TextBlock Text="Raf" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="8,0,8,0" VerticalAlignment="Center"/>
                            <Border Background="#EAF1FD" CornerRadius="9" MinWidth="20" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock x:Name="ShelfCountText" FontSize="11.5" FontWeight="SemiBold" Foreground="#1F4FA8" HorizontalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <Popup x:Name="ShelfPopup"
                           PlacementTarget="{Binding ElementName=ShelfChip}"
                           Placement="Top"
                           VerticalOffset="6"
                           AllowsTransparency="True"
                           StaysOpen="False"
                           PopupAnimation="{Binding PopupAnimation, Source={x:Static services:UiAnimationSettings.Current}}">
                        <Border Width="330" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12"
                                Padding="8" Margin="12,12,12,12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.15" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel>
                                <Grid Margin="6,2,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ShelfTitleText" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Style="{StaticResource SelectionBarButton}" Content="Boşalt"
                                            ToolTip="Raftaki tüm öğeleri bırak (dosyalara dokunmaz)" Click="ShelfClear_Click"/>
                                </Grid>
                                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ShelfItems">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="6,3,2,3" ToolTip="{Binding Path}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Folder}" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Style="{StaticResource TabCloseButton}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                            ToolTip="Raftan çıkar" Click="ShelfRemoveItem_Click"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Border Height="1" Background="#EEF2F7" Margin="4,6,4,8"/>
                                <TextBlock x:Name="ShelfDestinationText" FontSize="11.5" Foreground="#64748B" Margin="6,0,6,8" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                    <Button x:Name="ShelfCopyButton" Style="{StaticResource ShelfPrimaryButton}" Content="Buraya kopyala" Click="ShelfCopy_Click"/>
                                    <Button x:Name="ShelfMoveButton" Style="{StaticResource SelectionBarButton}" Content="Buraya taşı" Margin="6,0,0,0" Click="ShelfMove_Click"/>
                                    <Button Style="{StaticResource SelectionBarButton}" Content="Panoya al" Click="ShelfClipboard_Click"
                                            ToolTip="Dosyaları panoya koy; Explorer'da da yapıştırabilirsin"/>
                                </StackPanel>
                                <Border x:Name="ShelfDragHandle" Margin="4,8,4,0" Padding="8,6" CornerRadius="8" Background="#F8FAFC"
                                        Cursor="SizeAll" MouseLeftButtonDown="ShelfDragHandle_MouseDown"
                                        MouseMove="ShelfDragHandle_MouseMove" MouseLeftButtonUp="ShelfDragHandle_MouseUp">
                                    <TextBlock Text="⠿  Hepsini sürükle: bir klasöre ya da Explorer'a" FontSize="11.5" Foreground="#64748B"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>

            <Border x:Name="SelectionBar"
                    Grid.Row="3"
                    Visibility="Collapsed"
                    Background="#FFFFFF"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,1,0,0"
                    Padding="20,8,14,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SelectionCountText" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SelectionBarButton}" Content="Kopyala" ToolTip="Ctrl+C" Click="SelectionCopy_Click"/>
                        <Button Style="{StaticResource SelectionBarButton}" Content="Kes" ToolTip="Ctrl+X" Click="SelectionCut_Click"/>
                        <Button Style="{StaticResource SelectionBarButton}" Content="Yeniden adlandır" ToolTip="Hepsini birlikte adlandır (F2)" Click="SelectionRename_Click"/>
                        <Button x:Name="SelectionMoreButton" Style="{StaticResource SelectionBarButton}" Content="Diğer ▾" ToolTip="Yolu kopyala, sıkıştır, rafa ekle…" Click="SelectionMore_Click"/>
                        <Button Style="{StaticResource SelectionBarButton}" Content="Sil" Foreground="#B42318" ToolTip="Geri Dönüşüm Kutusu'na taşı (Del)" Click="SelectionDelete_Click"/>
                        <Button Style="{StaticResource SelectionBarButton}" Content="✕" Padding="9,5" Margin="4,0,0,0"
                                ToolTip="Seçimi kaldır (Esc)" AutomationProperties.Name="Seçimi kaldır" Click="SelectionClear_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Delta Sync Progress Row (Row 2) - Below content, extends window height -->
            <Grid Grid.Row="4">
                <!-- Search catalog build row -->
                <Border x:Name="CatalogBuildPanel"
                        Background="#FFFFFF"
                        CornerRadius="0,0,8,8"
                        Padding="14,11,14,14"
                        Visibility="Collapsed"
                        BorderBrush="#E2E8F0"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource BannerIconPill}" Background="#EEF4FF" VerticalAlignment="Top">
                            <Path Data="{StaticResource MagnifierGeometry}" Stroke="#3F7EE8" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="15" Height="15" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Arama kataloğu hazırlanıyor" Style="{StaticResource BannerTitle}"/>
                            <TextBlock x:Name="CatalogBuildStatus" Text="Arama hazırlanıyor..." Style="{StaticResource BannerDetail}"/>
                            <Grid Height="3" Margin="0,9,0,0" ClipToBounds="True">
                                <Border Background="#E3ECFB" CornerRadius="1.5"/>
                                <Border x:Name="CatalogBuildPulse" Width="140" CornerRadius="1.5" HorizontalAlignment="Left">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#003F7EE8" Offset="0"/>
                                            <GradientStop Color="#3F7EE8" Offset="0.5"/>
                                            <GradientStop Color="#003F7EE8" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="CatalogBuildPulseShift" X="-140"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Delta Sync Progress Indicator (Expanded View) -->
                <Border x:Name="DeltaSyncPanel"
                        Background="#FFFFFF"
                        CornerRadius="0,0,8,8"
                        Padding="14,11,14,14"
                        Visibility="Collapsed"
                        BorderBrush="#E2E8F0"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource BannerIconPill}" Background="#EEF4FF" VerticalAlignment="Top">
                            <Path Data="{StaticResource SyncGeometry}" Stroke="#3F7EE8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="15" Height="15" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="DeltaSyncText" Text="Değişiklikler kontrol ediliyor" Style="{StaticResource BannerTitle}"/>
                                <TextBlock x:Name="DeltaSyncDetails" Text="" Style="{StaticResource BannerDetail}" Margin="6,0,0,0" VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <ProgressBar x:Name="DeltaSyncProgressBar"
                                         Height="3"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         IsIndeterminate="False"
                                         Foreground="#3F7EE8"
                                         Background="#E3ECFB"
                                         Margin="0,9,0,0"
                                         BorderThickness="0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource BannerCloseButton}" VerticalAlignment="Top" Click="MinimizeDeltaSync_Click" ToolTip="Simge durumuna küçült">
                            <Path Data="{StaticResource MinusGlyphGeometry}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="8" Height="8" Stretch="None"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Delta Sync Minimized Indicator -->
                <Border x:Name="DeltaSyncMinimized"
                        Background="#FFFFFF"
                        CornerRadius="0,0,8,8"
                        Padding="12,9"
                        Visibility="Collapsed"
                        BorderBrush="#E2E8F0"
                        BorderThickness="0,1,0,0"
                        Cursor="Hand"
                        MouseLeftButtonDown="ExpandDeltaSync_Click"
                        ToolTip="Tıklayarak genişlet">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="{StaticResource SyncGeometry}" Stroke="#3F7EE8" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock x:Name="DeltaSyncMinimizedText"
                                   Text="Kontrol ediliyor"
                                   FontSize="12"
                                   Foreground="#2F4A73"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Canvas x:Name="FileTransferOverlay" Grid.RowSpan="5" Grid.ColumnSpan="2" Panel.ZIndex="10" IsHitTestVisible="False">
                <Border x:Name="FileTransferLabel" Visibility="Collapsed" Padding="9,5" CornerRadius="6"
                        Background="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" BorderThickness="1">
                    <TextBlock x:Name="FileTransferText" MaxWidth="340" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}" FontSize="12"/>
                </Border>
            </Canvas>
        </Grid>
    </Border>
</Window>
