<Window x:Class="SmartFileLauncher.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OmniSpot Ayarları"
        Width="640"
        Height="740"
        MinWidth="520"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F5F5F7">
    
    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#007AFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Background" Value="#E5E5EA"/>
            <Setter Property="Foreground" Value="#1D1D1F"/>
        </Style>
        
        <!-- Section Header Style -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1D1D1F"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="⚙️ Ayarlar" 
                       FontSize="24" 
                       FontWeight="Bold"
                       Foreground="#1D1D1F"/>
            <TextBlock Text="OmniSpot kısayol ve tercihlerini düzenleyin"
                       FontSize="13"
                       Foreground="#86868B"
                       Margin="0,4,0,0"/>
        </StackPanel>
        
        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                
                <!-- Hotkey Section -->
                <Border Background="White" 
                        CornerRadius="12" 
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="🔑 Kısayol Tuşu" Style="{StaticResource SectionHeader}"/>
                        
                        <TextBlock Text="OmniSpot'u uyandırmak için kullanılacak global kısayol:"
                                   FontSize="12"
                                   Foreground="#86868B"
                                   Margin="0,0,0,12"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Current Hotkey Display -->
                            <Border Grid.Column="0"
                                    Background="#F5F5F7"
                                    BorderBrush="#E5E5EA"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,10"
                                    Margin="0,0,12,0">
                                <TextBlock x:Name="CurrentHotkeyText"
                                           Text="Alt + Space"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           Foreground="#1D1D1F"
                                           VerticalAlignment="Center"/>
                            </Border>
                            
                            <!-- Change Button -->
                            <Button Grid.Column="1"
                                    x:Name="ChangeHotkeyButton"
                                    Content="Değiştir"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="ChangeHotkeyButton_Click"/>
                        </Grid>
                        
                        <!-- Hotkey Recording Overlay -->
                        <Border x:Name="HotkeyRecordingPanel"
                                Background="#FFF3CD"
                                BorderBrush="#FFECB5"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,12,0,0"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="⌨️ Yeni kısayolu girin..."
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#856404"/>
                                <TextBlock x:Name="RecordingHotkeyText"
                                           Text="Bir tuş kombinasyonu basın"
                                           FontSize="12"
                                           Foreground="#856404"
                                           Margin="0,4,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Tamam"
                                            Style="{StaticResource ModernButton}"
                                            Width="80"
                                            Click="ConfirmHotkey_Click"
                                            Margin="0,0,8,0"/>
                                    <Button Content="İptal"
                                            Style="{StaticResource SecondaryButton}"
                                            Width="80"
                                            Click="CancelHotkey_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                
                <!-- Startup Section -->
                <Border Background="White" 
                        CornerRadius="12" 
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="🚀 Başlangıç" Style="{StaticResource SectionHeader}"/>
                        
                        <CheckBox x:Name="StartMinimizedCheckbox"
                                  Content="Minimize başlat"
                                  FontSize="13"
                                  Foreground="#1D1D1F"
                                  Margin="0,0,0,8"/>
                        
                        <CheckBox x:Name="StartWithWindowsCheckbox"
                                  Content="Windows ile birlikte başlat"
                                  FontSize="13"
                                  Foreground="#1D1D1F"
                                  Margin="0,0,0,8"/>
                        
                        <CheckBox x:Name="MinimizeToTrayCheckbox"
                                  Content="Kapatma butonunda system tray'e küçült"
                                  FontSize="13"
                                  Foreground="#1D1D1F"
                                  IsChecked="True"/>
                    </StackPanel>
                </Border>
                
                <!-- Defaults Section -->
                <Border Background="White" 
                        CornerRadius="12" 
                        Padding="16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="📋 Varsayılanlar" Style="{StaticResource SectionHeader}"/>
                        
                        <CheckBox x:Name="NaturalLanguageDefaultCheckbox"
                                  Content="AI modunu varsayılan olarak aç"
                                  FontSize="13"
                                  Foreground="#1D1D1F"
                                  Margin="0,0,0,8"/>
                        
                        <CheckBox x:Name="GridViewDefaultCheckbox"
                                  Content="Grid görünümünü varsayılan olarak aç"
                                  FontSize="13"
                                  Foreground="#1D1D1F"/>
                    </StackPanel>
                </Border>
                
                <Border x:Name="ThumbnailSettingsCard" Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Küçük resimler ve RAM" Style="{StaticResource SectionHeader}"/>
                        <CheckBox x:Name="ThumbnailEnabled" Content="Küçük resim önizlemelerini göster" FontSize="13"
                                  Checked="ThumbnailSettingChanged" Unchecked="ThumbnailSettingChanged" Margin="0,0,0,16"/>
                        <StackPanel x:Name="ThumbnailControls">
                            <TextBlock Text="Bellek sınırı" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox x:Name="ThumbnailMode" SelectionChanged="ThumbnailSettingChanged" Padding="6" Margin="0,0,0,12"
                                      AutomationProperties.Name="Thumbnail bellek sınırı modu">
                                <ComboBoxItem Content="Manuel — görsel adedi"/>
                                <ComboBoxItem Content="Oran — toplam RAM'in yüzdesi"/>
                            </ComboBox>
                            <StackPanel x:Name="ThumbnailManualPanel" Margin="0,0,0,10">
                                <Label Content="En fazla kaç görsel RAM'de tutulsun?" Target="{Binding ElementName=ThumbnailCount}" Padding="0,0,0,5"/>
                                <TextBox x:Name="ThumbnailCount" Padding="8,5" MaxLength="10" TextChanged="ThumbnailSettingChanged"/>
                            </StackPanel>
                            <StackPanel x:Name="ThumbnailRatioPanel" Margin="0,0,0,10">
                                <TextBlock x:Name="ThumbnailRatioValue" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                <Slider x:Name="ThumbnailRatio" Minimum="0" SmallChange="0.005" LargeChange="0.05"
                                        ValueChanged="ThumbnailSettingChanged" AutomationProperties.Name="Toplam RAM yüzdesi"/>
                            </StackPanel>
                            <TextBlock x:Name="ThumbnailBudget" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <TextBlock x:Name="ThumbnailSafeLimit" Foreground="#515159" TextWrapping="Wrap" FontSize="12"/>
                            <TextBlock x:Name="ThumbnailMemoryTitle" FontWeight="SemiBold" Margin="0,18,0,8"/>
                            <Grid Height="18" ClipToBounds="True" AutomationProperties.Name="Tahmini RAM dağılımı">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="ThumbnailOtherColumn"/>
                                    <ColumnDefinition x:Name="ThumbnailAppColumn"/>
                                    <ColumnDefinition x:Name="ThumbnailCacheColumn"/>
                                    <ColumnDefinition x:Name="ThumbnailFreeColumn"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#64748B" ToolTip="Diğer RAM kullanımı"/>
                                <Border Grid.Column="1" Background="#334155" ToolTip="OmniSpot, thumbnail cache hariç (tahmini)"/>
                                <Border Grid.Column="2" Background="#0066CC" ToolTip="Ayarlanan thumbnail bütçesi"/>
                                <Border Grid.Column="3" Background="#E5E7EB" ToolTip="Tahmini kalan RAM"/>
                            </Grid>
                            <WrapPanel Margin="0,8,0,0">
                                <TextBlock x:Name="ThumbnailOtherLabel" Foreground="#475569" Margin="0,0,16,5"/>
                                <TextBlock x:Name="ThumbnailAppLabel" Foreground="#334155" Margin="0,0,16,5"/>
                                <TextBlock x:Name="ThumbnailCacheLabel" Foreground="#0059B3" Margin="0,0,16,5"/>
                                <TextBlock x:Name="ThumbnailFreeLabel" Foreground="#515159" Margin="0,0,0,5"/>
                            </WrapPanel>
                            <TextBlock Text="Yaklaşık önizleme: önbellek tamamen dolduğunda beklenen dağılım. Seçtiğiniz bütçe hemen RAM'e yüklenmez."
                                       TextWrapping="Wrap" Foreground="#515159" FontSize="12" Margin="0,4,0,16"/>
                            <Label Content="Hareketsizlikten sonra boşalt (saniye)" Target="{Binding ElementName=ThumbnailIdle}" Padding="0,0,0,5"/>
                            <TextBox x:Name="ThumbnailIdle" Padding="8,5" MaxLength="6"/>
                            <TextBlock Text="Yalnız OmniSpot içindeki fare ve klavye hareketleri süreyi yeniler. Varsayılan: 60 saniye."
                                       TextWrapping="Wrap" Foreground="#515159" FontSize="12" Margin="0,6,0,16"/>
                            <TextBlock Text="Boşta kalınca da RAM'de tut" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Text="Seçili klasörler ve alt klasörleri. Yalnız gezinirken yüklenen görseller korunur; genel RAM sınırı geçerlidir."
                                       TextWrapping="Wrap" Foreground="#515159" FontSize="12" Margin="0,0,0,8"/>
                            <Grid>
                            <ListBox x:Name="ThumbnailFolders" MinHeight="64" MaxHeight="120" HorizontalContentAlignment="Stretch"
                                     AutomationProperties.Name="Küçük resimleri RAM'de tutulacak klasörler">
                                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" ToolTip="{Binding}" TextTrimming="CharacterEllipsis" Padding="4"/></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="Henüz klasör eklenmedi." Foreground="#515159" Margin="8,10" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding ElementName=ThumbnailFolders, Path=HasItems}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Klasör ekle…" Style="{StaticResource SecondaryButton}" Click="AddThumbnailFolder_Click" Margin="0,0,8,0"/>
                                <Button Content="Seçileni kaldır" Style="{StaticResource SecondaryButton}" Click="RemoveThumbnailFolder_Click" IsEnabled="{Binding ElementName=ThumbnailFolders, Path=HasItems}"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="ThumbnailValidation" Foreground="#A4262C" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Search Index Section -->
                <Border Background="White" 
                        CornerRadius="12" 
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="🔎 Arama İndeksi" Style="{StaticResource SectionHeader}"/>

                        <TextBlock Text="Dosya adları ve arama bilgileri hızlı erişim için yerel indekste saklanır."
                                   FontSize="12"
                                   Foreground="#86868B"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12"/>
                        
                        <TextBlock Text="İndeks durumu:"
                                   FontSize="12"
                                   Foreground="#86868B"
                                   Margin="0,0,0,4"/>
                        
                        <Border Background="#F5F5F7"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="IndexStatusText"
                                               Text="✅ İndeks mevcut"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="#1D1D1F"/>
                                    <TextBlock x:Name="IndexSizeText"
                                               Text="Boyut: 0 KB"
                                               FontSize="11"
                                               Foreground="#86868B"
                                               Margin="0,2,0,0"/>
                                    <TextBlock x:Name="IndexPathText"
                                               Text="Konum: %APPDATA%\OmniSpot\index.db"
                                               FontSize="10"
                                               Foreground="#AAAAAA"
                                               Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="RebuildIndexButton"
                                    Content="🔄 İndeksi Yeniden Oluştur"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="RebuildIndex_Click"
                                    Padding="12,8"/>
                            <Button x:Name="OpenIndexFolderButton"
                                    Content="📂 Klasörü Aç"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="OpenIndexFolder_Click"
                                    Padding="12,8"
                                    Margin="8,0,0,0"/>
                        </StackPanel>
                        
                        <TextBlock Text="💡 Eksik veya eski sonuçlarda indeksi yeniden oluşturabilirsiniz. Uygulama yeniden başlatılır ve standart klasörler tekrar taranır."
                                   FontSize="11"
                                   Foreground="#86868B"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="🔁 Uygulama" Style="{StaticResource SectionHeader}"/>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="RestartApplicationButton"
                                    Content="🔁 Yeniden Başlat"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="RestartApplication_Click"
                                    Padding="12,8"/>
                        </StackPanel>

                        <TextBlock Text="💡 OmniSpot kapanır ve yeniden açılır. İndeks silinmez. Kaydedilmemiş ayar değişiklikleri uygulanmaz."
                                   FontSize="11"
                                   Foreground="#86868B"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
        
        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,24,0,0">
            <Button Content="Varsayılanlara Sıfırla"
                    Style="{StaticResource SecondaryButton}"
                    Click="ResetDefaults_Click"
                    Margin="0,0,12,0"/>
            <Button Content="Kaydet"
                    Style="{StaticResource ModernButton}"
                    Click="Save_Click"
                    Width="100"/>
        </StackPanel>
    </Grid>
</Window>
