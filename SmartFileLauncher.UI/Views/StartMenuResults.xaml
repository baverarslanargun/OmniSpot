<UserControl x:Class="SmartFileLauncher.UI.Views.StartMenuResults"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SmartFileLauncher.UI.Views"
             Focusable="False">
    <UserControl.Resources>
        <ItemsPanelTemplate x:Key="ListPanel">
            <VirtualizingStackPanel/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="StripPanel">
            <local:ApplicationChipPanel/>
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="GridPanel">
            <local:ApplicationTilePanel Columns="4" ItemHeight="140"/>
        </ItemsPanelTemplate>

        <Style x:Key="MissingIconGlyph" TargetType="TextBlock">
            <Setter Property="Text" Value="&#xE71D;"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PinnedGlyph" TargetType="TextBlock">
            <Setter Property="Text" Value="&#xE840;"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="ToolTip" Value="OmniSpot'ta sabitlendi"/>
            <Setter Property="Visibility">
                <Setter.Value>
                    <MultiBinding Converter="{x:Static local:PinnedApplicationVisibility.Instance}">
                        <Binding Path="Id"/>
                        <Binding Path="PinnedIds" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                    </MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="RowTemplate">
            <DockPanel>
                <TextBlock x:Name="RowPinned" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource PinnedGlyph}"/>
                <Grid DockPanel.Dock="Left" Width="44" Height="32" Margin="0,0,14,0">
                    <TextBlock FontSize="19">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MissingIconGlyph}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Source, ElementName=Icon}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Image x:Name="Icon" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"
                           Loaded="IconLoaded" Unloaded="IconUnloaded" DataContextChanged="IconDataContextChanged"/>
                </Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Detail}" ToolTip="{Binding Detail}" FontSize="11" Foreground="#64748B"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Detail}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="ChipTemplate">
            <DockPanel>
                <Grid DockPanel.Dock="Left" Width="22" Height="22" Margin="0,0,8,0">
                    <TextBlock FontSize="14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MissingIconGlyph}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Source, ElementName=Icon}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Image x:Name="Icon" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"
                           Loaded="IconLoaded" Unloaded="IconUnloaded" DataContextChanged="IconDataContextChanged"/>
                </Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ChipName" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ChipDetail" Text="{Binding Detail}" Margin="0,1,0,0" FontSize="11.5"
                               Foreground="#64748B" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Detail}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="TileTemplate">
            <Grid>
                <StackPanel VerticalAlignment="Top">
                    <Grid Width="40" Height="40" Margin="0,0,0,10" HorizontalAlignment="Center">
                        <TextBlock FontSize="26">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MissingIconGlyph}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source, ElementName=Icon}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Image x:Name="Icon" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"
                               Loaded="IconLoaded" Unloaded="IconUnloaded" DataContextChanged="IconDataContextChanged"/>
                    </Grid>
                    <TextBlock x:Name="TileName" Text="{Binding Name}" FontSize="12" FontWeight="Medium" Foreground="#334155"
                               TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               MaxHeight="32" LineHeight="16" LineStackingStrategy="BlockLineHeight"/>
                    <TextBlock Text="{Binding Detail}" Margin="0,2,0,0" FontSize="11" Foreground="#94A3B8"
                               TextAlignment="Center" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Detail}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <TextBlock x:Name="TilePinned" Margin="0,-6,-4,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                           Style="{StaticResource PinnedGlyph}"/>
            </Grid>
        </DataTemplate>

        <Style x:Key="TileItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="ToolTip" Value="{Binding Name}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
            <Setter Property="AutomationProperties.HelpText" Value="{Binding Detail}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Surface" Padding="12,16,12,12" CornerRadius="16"
                                Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="local:StartMenuResults.Arriving" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Surface" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#007AFF"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowItem" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
            <Setter Property="AutomationProperties.HelpText" Value="{Binding Detail}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Surface" Margin="0,2" Padding="12,6" CornerRadius="10"
                                Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="local:StartMenuResults.Arriving" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Surface" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#007AFF"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChipItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="ToolTip" Value="{Binding Name}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
            <Setter Property="AutomationProperties.HelpText" Value="{Binding Detail}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Surface" MinHeight="34" MaxWidth="260" Padding="7,5,12,5" CornerRadius="10"
                                Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="local:StartMenuResults.Arriving" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Surface" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#007AFF"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource Self}}" Value="0"/>
                        <Condition Binding="{Binding LeadsWithBestMatch, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Collapsed"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StripButton" TargetType="Button">
            <Setter Property="Foreground" Value="#0062CC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Height="34" Padding="10,0" CornerRadius="10" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BackButton" TargetType="Button">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Height="26" Padding="6,0,10,0" CornerRadius="8" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#1E293B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="16,6,16,4">
        <Button x:Name="BrowseBack" Visibility="Collapsed" Margin="0,0,0,3" HorizontalAlignment="Left"
                Style="{StaticResource BackButton}" ToolTip="Aramaya dön (Esc)"
                AutomationProperties.Name="Aramaya dön">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,1,8,0"
                           VerticalAlignment="Center"/>
                <TextBlock Text="Tüm uygulamalar" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border x:Name="BestMatch" Grid.Row="0" Visibility="Collapsed" Margin="0,2,0,4" Padding="12,12,16,12"
                    CornerRadius="14" BorderThickness="1" MouseLeftButtonDown="BestMatchMouseDown"
                    AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="En iyi eşleşme">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="TextElement.Foreground" Value="#1E293B"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding BestMatchSelected, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                <Setter Property="Background" Value="#EFF6FF"/>
                                <Setter Property="BorderBrush" Value="#007AFF"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Grid DockPanel.Dock="Left" Width="44" Height="44" Margin="0,0,14,0">
                        <TextBlock FontSize="26">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MissingIconGlyph}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source, ElementName=BestMatchIcon}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Image x:Name="BestMatchIcon" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality"
                               Loaded="IconLoaded" Unloaded="IconUnloaded" DataContextChanged="IconDataContextChanged"/>
                    </Grid>
                    <StackPanel x:Name="OpenHint" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BestMatchSelected, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Aç" FontSize="12" FontWeight="SemiBold" Foreground="#0062CC" VerticalAlignment="Center"/>
                        <Border Margin="8,0,0,0" MinWidth="24" Padding="6,1" CornerRadius="6" BorderThickness="1"
                                BorderBrush="#BFDBFE" Background="White">
                            <TextBlock Text="↵" FontSize="12" Foreground="#0062CC" HorizontalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Uygulama · en iyi eşleşme" Margin="0,2,0,0" FontSize="12" Foreground="#64748B"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid x:Name="BrowserLoading" Grid.Row="1" Height="460" Visibility="Collapsed">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="LoadingLabel" Text="Uygulamalar yükleniyor…" Foreground="#94A3B8"
                               AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="{Binding Text, ElementName=LoadingLabel}" Style="{DynamicResource LoadingTextGlint}"/>
                </Grid>
            </Grid>
            <Grid x:Name="Strip" Grid.Row="1" Margin="4,4,4,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StripLabel" Text="Uygulamalar" VerticalAlignment="Center" Margin="0,0,12,0"
                           FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                <ListBox x:Name="Applications" Grid.Column="1" HorizontalAlignment="Left"
                         Background="Transparent" BorderThickness="0" Padding="0" AlternationCount="64"
                         SelectedValuePath="Id" IsSynchronizedWithCurrentItem="False"
                         AutomationProperties.Name="Uygulamalar" HorizontalContentAlignment="Stretch"
                         ItemsPanel="{StaticResource StripPanel}" ItemContainerStyle="{StaticResource ChipItem}"
                         ItemTemplate="{StaticResource ChipTemplate}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.CacheLength="4" VirtualizingPanel.CacheLengthUnit="Item"
                         VirtualizingPanel.ScrollUnit="Pixel"/>
                <TextBlock x:Name="EmptyMessage" Grid.Column="1" Visibility="Collapsed" HorizontalAlignment="Left"
                           VerticalAlignment="Center" Foreground="#64748B"/>
                <Button x:Name="ShowAll" Grid.Column="2" Margin="4,0,0,0" Content="Tümü"
                        Style="{StaticResource StripButton}"
                        AutomationProperties.Name="Eşleşen tüm uygulamaları göster"/>
            </Grid>
            <Canvas x:Name="GlideLayer" Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True" Panel.ZIndex="1"/>
        </Grid>
    </StackPanel>
</UserControl>
